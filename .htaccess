# Schone URL's zoals op Squarespace: /about -> about.html
Options -MultiViews
RewriteEngine On
# Live domein: altijd https en met www (canonicals gebruiken www). Raakt ojod6.sg-host.com niet.
# Live domein: altijd https en met www (canonicals gebruiken www). Raakt ojod6.sg-host.com niet.
RewriteCond %{HTTP_HOST} ^justinnorman\.nl$ [NC]
RewriteRule ^(.*)$ https://www.justinnorman.nl/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.justinnorman\.nl$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.justinnorman.nl/$1 [R=301,L]
# Oude portfolio-URL
RewriteRule ^home-1-2/?$ /portfolio [R=301,L]
RewriteRule ^about-2/?$ /hoppenbrouwers [R=301,L]
# Oude .html-adressen permanent naar schone URL's (voorkomt de nginx-cache op .html)
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
ErrorDocument 404 /404.html

# HTML nooit lang cachen; CSS/JS/afbeeldingen hebben versienummers en mogen lang
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set X-Cache-Enabled "False"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
