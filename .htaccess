# Schone URL's zoals op Squarespace: /about -> about.html
Options -MultiViews
RewriteEngine On
# Oude .html-adressen permanent naar schone URL's (voorkomt de nginx-cache op .html)
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
ErrorDocument 404 /404.html

# HTML nooit lang cachen; CSS/JS/afbeeldingen hebben versienummers en mogen lang
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
